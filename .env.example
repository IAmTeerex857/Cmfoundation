# Copy to .env.local for local development. In production, set these in the hosting dashboard
# (e.g. Vercel → Settings → Environment Variables) and redeploy.

# Public URL of the site (sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://cm.foundation

# --- Donations: Bachs payment links (https://bachs.io) ---
# The naira link is built in (src/lib/payment-links.ts); set BACHS_PAYMENT_LINK_NGN only to replace it.
# For extra options, create links in the Bachs dashboard with "customer chooses amount" and a redirect
# after payment to https://cm.foundation/support/thank-you. Unset options are hidden.
BACHS_PAYMENT_LINK_NGN=
BACHS_PAYMENT_LINK_USD=
BACHS_PAYMENT_LINK_MONTHLY=

# --- Email ---
# Contact messages and newsletter sign-ups are sent to CONTACT_TO from CONTACT_FROM (an address on
# cm.foundation). Incoming mail to @cm.foundation is forwarded to the Foundation's Gmail by Cloudflare
# Email Routing, which needs no variables here.
# Sending uses Resend when RESEND_API_KEY is set (a sending-access key for cm.foundation).
RESEND_API_KEY=
# Fallback: Cloudflare Email Service. On the free plan it can only send to verified Email Routing addresses.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_TOKEN=
CONTACT_TO=cmf.helloo@gmail.com
CONTACT_FROM="CMF Website <website@cm.foundation>"

# --- Donation purposes (instructions §8.4) ---
# One Bachs payment link per purpose, so the payment record shows what each gift is for.
# Unset purposes fall back to the main naira link (counted as general support).
BACHS_PAYMENT_LINK_SCHOLARSHIPS=
BACHS_PAYMENT_LINK_LITERATURE=
BACHS_PAYMENT_LINK_COMMUNITY=

# --- Reader accounts ---
# Signs sign-in links and session cookies. Any long random string: `openssl rand -base64 32`.
READER_AUTH_SECRET=

# --- Database: Supabase (reader sync, inbox, dashboard, reports) ---
# Run supabase/migrations/*.sql in the Supabase SQL editor first. The service-role key is a server
# secret: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Management dashboard (/admin) and reports ---
# Email addresses allowed into the dashboard (comma-separated). They sign in with an emailed link.
ADMIN_EMAILS=
# Who receives the daily, weekly and monthly reports (comma-separated; defaults to CONTACT_TO).
REPORT_TO=
# Vercel sends this to /api/cron/report; any long random string.
CRON_SECRET=

# --- Google measurement (instructions §9) ---
# Google Tag Manager container (preferred), or a GA4 measurement ID if not using GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# Search Console "HTML tag" verification value (or verify by DNS in Cloudflare instead).
GOOGLE_SITE_VERIFICATION=
# Looker Studio report embed URL, shown on the dashboard.
NEXT_PUBLIC_LOOKER_STUDIO_URL=
