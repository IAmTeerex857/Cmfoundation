# Copy to .env.local for local development. In production, set these in the hosting dashboard
# (e.g. Vercel → Settings → Environment Variables) and redeploy.

# Public URL of the site (sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://cm.foundation

# --- Donations: Bachs payment links (https://bachs.io) ---
# The naira link is built in (src/lib/payment-links.ts); set BACHS_PAYMENT_LINK_NGN only to replace it.
# For extra options, create links in the Bachs dashboard with "customer chooses amount" and a redirect
# after payment to https://cm.foundation/support/thank-you. Unset options are hidden.
BACHS_PAYMENT_LINK_NGN=
BACHS_PAYMENT_LINK_USD=
BACHS_PAYMENT_LINK_MONTHLY=

# --- Email: Cloudflare Email Service ---
# Contact messages and newsletter sign-ups are sent to CONTACT_TO from CONTACT_FROM (an address on
# cm.foundation, onboarded for Email Sending). Incoming mail to hello@cm.foundation is forwarded to
# the Foundation's Gmail by Cloudflare Email Routing, which needs no variables here.
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Email Sending: Edit" permission.
CLOUDFLARE_EMAIL_TOKEN=
CONTACT_TO=hello@cm.foundation
CONTACT_FROM="CMF Website <website@cm.foundation>"
